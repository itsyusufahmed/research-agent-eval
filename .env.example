# Copy to .env in the repo root and fill in only the keys you need. Environment variables win over .env.
# Every script prints its plan and spends nothing without --yes.

# Exa Agent API key (run_exa_agent.py)
EXA_API_KEY=
# Parallel Task API key (run_parallel_task.py and run_parallel_flat.py)
PARALLEL_API_KEY=
# Clay API key for the Routines API (run_claygent.py)
CLAY_API_KEY=
# Optional per-model Clay key for the Auto column; falls back to CLAY_API_KEY (run_claygent.py)
CLAY_API_KEY_AUTO=
# Optional per-model Clay key for the Argon column; falls back to CLAY_API_KEY (run_claygent.py)
CLAY_API_KEY_ARGON=
# Optional per-model Clay key for the Luna column; falls back to CLAY_API_KEY (run_claygent.py)
CLAY_API_KEY_LUNA=
# Anthropic API key for the LLM adjudicator (grade.py, only with --yes)
ANTHROPIC_API_KEY=
# Firecrawl API key: snapshot.py needs it unless --no-firecrawl; grade.py uses it as a fetch fallback when set
FIRECRAWL_API_KEY=
